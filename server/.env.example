# ==============================================================================
# Stock Analyzer Backend Environment Configuration Template
# Path: server/.env
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Atlas URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/stock_analyzer?retryWrites=true&w=majority

# JWT Signing Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_secret_string

# Groq LLM API Key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key

# Stock Data API Providers
FINNHUB_API_KEY=your_finnhub_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
TWELVE_DATA_API_KEY=your_twelve_data_key
