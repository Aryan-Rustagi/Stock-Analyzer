# ==============================================================================
# Stock Analyzer — Environment Variables & Secrets Template
# Copy this file to server/.env and fill in your private API keys.
# DO NOT commit the active .env file to Git!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/stock_analyzer?retryWrites=true&w=majority

# Authentication Security (Cryptographic signing secret for JWT)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# AI / LLM Configuration (Groq Cloud API Key)
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Stock Market Data Providers (3-Tier High Availability Fallback)
# 1. Primary: Finnhub API (https://finnhub.io)
FINNHUB_API_KEY=your_finnhub_api_key_here

# 2. Secondary: Alpha Vantage API (https://www.alphavantage.co)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# 3. Tertiary: Twelve Data API (https://twelvedata.com)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
